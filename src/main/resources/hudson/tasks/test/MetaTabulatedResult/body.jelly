<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout" xmlns:t="/lib/hudson/test">
  <st:once>
    <link rel="stylesheet" href="${resURL}/plugin/junit/styles.css" defer="true" />
    <st:adjunct includes="lib.hudson.test.js.failureSummary" />
    <st:adjunct includes="lib.hudson.test.js.testTree" />
  </st:once>

  <!-- Failures are shown straight away. Skipped and passing tests are only loaded once they're turned on in the
       report's filter, as there are usually many more of them -->
  <div id="tasks" class="jp-test-lists">
    <j:if test="${it.failCount!=0}">
      <div class="jp-test-list" data-status="failed">
        <t:groupedTaskList result="${it}" status="failed" />
      </div>
    </j:if>

    <j:set var="listUrl" value="${h.getNearestAncestorUrl(request2, it)}/testList?status=" />
    <j:if test="${it.skipCount!=0}">
      <div class="jp-test-list" data-status="skipped" data-lazy-url="${listUrl}skipped"
           data-error-text="${%loadFailedSkipped}" hidden="hidden">
        <span class="jenkins-spinner">${%Loading...}</span>
      </div>
    </j:if>
    <j:if test="${it.passCount!=0}">
      <div class="jp-test-list" data-status="passed" data-lazy-url="${listUrl}passed"
           data-error-text="${%loadFailedPassed}" hidden="hidden">
        <span class="jenkins-spinner">${%Loading...}</span>
      </div>
    </j:if>

    <p class="jp-test-lists__empty jenkins-!-text-color-secondary" hidden="hidden">
      ${%noMatches}
    </p>

<!--    <j:if test="${it.totalCount!=0}">-->
<!--      <div class="jenkins-side-nav__heading">-->
<!--        All tests-->
<!--      </div>-->
<!--      <div class="jp-test-tree" id="testresult">-->
<!--        <j:forEach var="node" items="${it.allTestsTree}">-->
<!--          <st:include it="${node}" page="tree.jelly" />-->
<!--        </j:forEach>-->
<!--      </div>-->
<!--    </j:if>-->
  </div>
</j:jelly>
