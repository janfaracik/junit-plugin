<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:l="/lib/layout">
  <st:documentation>
    The panel that a test table's rows open their test result in, floating at the side of the page.
    Pages with test tables include this once; without it, the rows link to the test result's page instead.
  </st:documentation>

  <st:once>
    <!-- the test results shown in the panel have copy buttons, whose scripts don't run when they're loaded in -->
    <st:adjunct includes="lib.layout.copyButton.copyButton" />
    <st:adjunct includes="lib.hudson.test.copyAsPromptButton.copyAsPromptButton" />

    <!-- cloned by failureSummary.js the first time a row is clicked -->
    <template id="jp-test-panel-template">
      <aside class="jp-test-panel" aria-label="${%Test result}" tabindex="-1" data-error-text="${%loadFailed}">
        <div class="jp-test-panel__toolbar">
          <a class="jenkins-button jenkins-button--tertiary jp-test-panel__open" tooltip="${%Open test result}">
            <l:icon src="symbol-open-outline plugin-ionicons-api" />
          </a>
          <button type="button" class="jenkins-button jenkins-button--tertiary jp-test-panel__close" tooltip="${%Close}">
            <l:icon src="symbol-close-outline plugin-ionicons-api" />
          </button>
        </div>
        <div class="jp-test-panel__content" />
      </aside>
    </template>
  </st:once>
</j:jelly>
