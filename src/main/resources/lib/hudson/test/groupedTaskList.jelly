<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:t="/lib/hudson/test">
    <st:documentation>
        Lists the tests of a result that have the given status, grouped by class when the result has packages.

        <st:attribute name="result" use="required">
            The result whose tests to list, e.g. a hudson.tasks.junit.TestResult or PackageResult.
        </st:attribute>
        <st:attribute name="status" use="required">
            Which tests to list: 'failed', 'skipped' or 'passed'.
        </st:attribute>
    </st:documentation>

    <j:set var="result" value="${attrs.result}" />
    <j:set var="status" value="${attrs.status}" />

    <j:choose>
        <j:when test="${result.childType eq 'package'}">
            <j:forEach var="p" items="${result.children}">
                <j:if test="${(status eq 'failed' ? p.failCount : status eq 'skipped' ? p.skipCount : p.passCount) != 0}">
                    <j:forEach var="c" items="${p.children}">
                        <j:if test="${(status eq 'failed' ? c.failCount : status eq 'skipped' ? c.skipCount : c.passCount) != 0}">
                            <div class="jp-test-group">
                                <summary class="jenkins-side-nav__heading">
                                    <j:choose>
                                        <j:when test="${empty p.displayName}">(default package).${c.displayName}</j:when>
                                        <j:otherwise>${p.displayName}.${c.displayName}</j:otherwise>
                                    </j:choose>
                                </summary>
                                <t:taskList items="${status eq 'failed' ? c.failedTests : status eq 'skipped' ? c.skippedTests : c.passedTests}"
                                            relativeParent="${result}" />
                            </div>
                        </j:if>
                    </j:forEach>
                </j:if>
            </j:forEach>
        </j:when>
        <j:otherwise>
            <div class="jp-test-group">
                <t:taskList items="${status eq 'failed' ? result.failedTests : status eq 'skipped' ? result.skippedTests : result.passedTests}"
                            relativeParent="${result}" />
            </div>
        </j:otherwise>
    </j:choose>
</j:jelly>
